# Copiar a .env y completar. No versionar .env.
# Los valores "cambiar-esto" se reemplazan por secretos propios, distintos en cada entorno.

# Host con el que los usuarios acceden (localhost, o la IP/nombre de la PC en la red del depósito).
PUBLIC_HOST=localhost

KEYCLOAK_VERSION=26.0
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar-esto
OIDC_CLIENT_SECRET=cambiar-esto
DJANGO_SECRET_KEY=cambiar-esto

# Simulación del padrón (latencia en segundos y proporción de fallas 0..1)
MOCK_LATENCY_MIN=0.2
MOCK_LATENCY_MAX=7.0
MOCK_FAILURE_RATE=0.2

# Acceso remoto con ngrok (opcional, ADR-17). Dejar vacío para uso solo local.
# Con acceso remoto: PUBLIC_HOST=<dominio>.ngrok-free.app (sin https://) y
# PUBLIC_URL=https://<dominio>.ngrok-free.app. PUBLIC_HOST no debe quedar en localhost.
PUBLIC_URL=
NGROK_AUTHTOKEN=
