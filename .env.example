# Host con el que los usuarios acceden (localhost, o la IP/nombre de la PC en la red del depósito).

#expuesto a internet con ngrok
PUBLIC_HOST=pika-exotic-badger.ngrok-free.app

#local
#PUBLIC_HOST=localhost

KEYCLOAK_VERSION=26.0
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_CLIENT_SECRET=cs
OIDC_RP_CLIENT_SECRET=cs
DJANGO_SECRET_KEY=cito

# Simulación del padrón (latencia en segundos y proporción de fallas 0..1)
MOCK_LATENCY_MIN=0.2
MOCK_LATENCY_MAX=7.0
MOCK_FAILURE_RATE=0.2

# Acceso remoto con ngrok (opcional, ADR-15). Dejar vacío para uso solo local.
# PUBLIC_HOST = dominio de ngrok SIN https://; PUBLIC_URL = URL completa con https://.
# Con acceso remoto activo, PUBLIC_HOST no debe quedar en localhost.

#expuesto a internet con ngrok
PUBLIC_URL=https://pika-exotic-badger.ngrok-free.app
NGROK_AUTHTOKEN=

#local
#PUBLIC_URL=
#NGROK_AUTHTOKEN=