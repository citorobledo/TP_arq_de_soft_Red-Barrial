.env
backups/*
!backups/.gitkeep
__pycache__/
*.pyc
*.sqlite3
.venv/

Zone.Identifier
# Metadatos de Windows
*Zone.Identifier

# SQLite (los archivos -wal y -shm no los cubre *.sqlite3)
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# Variables de entorno: se versiona solo el ejemplo
.env.*
!.env.example

# Editor y herramientas
.vscode/
.idea/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

